            "open_with": "chrome"
        },
        {
            "id": "deepseek",
            "name": "DeepSeek",
            "aliases": [
                "дипсик"
            ],
            "url": "https://chat.deepseek.com",
            "open_with": "chrome"
        },
        {
            "id": "bitbucket",
            "name": "Bitbucket",
